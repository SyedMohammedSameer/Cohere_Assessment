# Copy this file to `.env` and fill in the values.

# Cohere API key.
COHERE_API_KEY=

# Cohere Chat model.
COHERE_MODEL=command-a-03-2025

# Per-request timeout to Cohere, in seconds.
COHERE_TIMEOUT_S=30

# Total attempts (initial try plus retries) on transient Cohere failures.
COHERE_MAX_ATTEMPTS=3

# Maximum rounds of tool calls before forcing a final, tool-free answer.
MAX_TOOL_ITERATIONS=5

# MediaWiki search endpoint and search behavior.
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
WIKIPEDIA_SEARCH_LIMIT=5
WIKIPEDIA_TIMEOUT_S=10
WIKIPEDIA_MAX_ATTEMPTS=3

# Wikipedia search cache. TTL of 0 disables caching.
WIKIPEDIA_CACHE_TTL_S=300
WIKIPEDIA_CACHE_MAX_ENTRIES=512

# Most recent messages replayed to the model on a multi-turn request.
MAX_HISTORY_MESSAGES=20

# Async SQLAlchemy database URL. SQLite by default; swap for Postgres
# (postgresql+asyncpg://...) in production without code changes.
DATABASE_URL=sqlite+aiosqlite:///./history.db

# Default page size for GET /history.
HISTORY_PAGE_SIZE=20

# Comma-separated API keys accepted in the X-API-Key header. Empty disables
# authentication (all callers share the "public" owner).
API_KEYS=

# Per-key (or per-client) requests allowed per minute. 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE=0

# Logging verbosity: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# Log output format: "json" for structured logs, "text" for human-readable.
LOG_FORMAT=json
